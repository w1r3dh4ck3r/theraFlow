# ============================================================
# TheraFlow – environment variable reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# WhatsApp Cloud API
# (Meta Developer Portal → Your App → WhatsApp → Configuration)
# ----------------------------------------------------------

# The numeric Phone Number ID for your WhatsApp Business number.
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Bearer token used to call the WhatsApp Cloud API.
# For production use a permanent System User token.
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxx

# Arbitrary secret you choose; must match what you enter in the
# Meta webhook configuration form.
WHATSAPP_VERIFY_TOKEN=my_super_secret_verify_token

# App Secret from Meta App Dashboard → Settings → Basic.
# Used to validate X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=abc123def456app_secret

# ----------------------------------------------------------
# Google Sheets
# ----------------------------------------------------------

# The long ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Path to the JSON key file for a Google Cloud Service Account
# that has Editor access to the spreadsheet above.
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google_service_account.json

# ----------------------------------------------------------
# Telegram notifications
# (Create a bot via @BotFather, then send a message to it and
#  inspect https://api.telegram.org/bot<TOKEN>/getUpdates for
#  your chat ID)
# ----------------------------------------------------------

TELEGRAM_BOT_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------------------------------------------
# HTTP server
# ----------------------------------------------------------

HOST=0.0.0.0
PORT=8000
